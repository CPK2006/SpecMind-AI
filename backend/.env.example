APP_NAME=SpecMind AI
APP_VERSION=0.1.0
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/specmind_ai
SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Provider credentials are optional. Configure new, rotated keys in backend/.env.
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Comma-separated Gemini keys; the legacy single key remains supported.
GEMINI_API_KEYS=
GEMINI_API_KEY=
